# --- Node / Next ---
NODE_ENV=development
APP_BASE_URL=http://localhost:7000

# --- Database ---
DATABASE_URL=postgresql://inventory:inventory@localhost:5432/inventory?schema=public

# --- Auth (NextAuth.js) ---
# Generate with:  openssl rand -hex 32
NEXTAUTH_SECRET=replace-me-with-a-long-random-string
NEXTAUTH_URL=http://localhost:7000

# --- Mail (SMTP) ---
# Dev: Mailhog (docker-compose) exposes 1025/8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Inventory <no-reply@inventory.local>"

# --- Logging ---
LOG_LEVEL=info

# --- Scheduled jobs ---
LOW_STOCK_SCAN_CRON="*/15 * * * *"
NEAR_EXPIRY_SCAN_CRON="0 9 * * *"
NEAR_EXPIRY_WINDOW_DAYS=30

# --- Rate limits ---
RATE_LIMIT_AUTH_PER_MIN=5
RATE_LIMIT_API_PER_MIN=60

# --- Feature flags ---
DISABLE_BACKGROUND_JOBS=false
